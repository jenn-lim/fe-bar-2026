# Databricks Asset Bundle build artifacts (generated by `bundle deploy`).
# Contains the compiled Terraform (bundle.tf.json) and tfstate with
# workspace-specific, resolved values — never commit or share these.
.databricks/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local, workspace-specific overrides (kept out of the shared repo)
*.local.yml
